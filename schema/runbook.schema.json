{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tomlabs.cz/schemas/runbook-1.schema.json",
  "title": "Runbook (format version 1)",
  "description": "Canonical model of a RunbookWizard guide. A *.runbook.md file is converted to this shape before validation; a *.runbook.json file is this shape.",
  "type": "object",
  "required": ["runbook", "title", "steps"],
  "additionalProperties": false,
  "properties": {
    "runbook": { "const": 1, "description": "Format version." },
    "title": { "type": "string", "minLength": 1, "maxLength": 200 },
    "description": { "type": "string", "description": "Introduction shown before the first step (Markdown allowed)." },
    "version": { "type": "string", "description": "Version of the guide itself, free form, e.g. 1.2." },
    "author": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "platforms": {
      "type": "array",
      "items": { "enum": ["windows", "linux", "macos"] },
      "uniqueItems": true,
      "description": "Operating systems the guide is written for. Omitted = any."
    },
    "shell": { "$ref": "#/$defs/shell", "description": "Default shell of script steps. Default: powershell." },
    "variables": { "type": "array", "items": { "$ref": "#/$defs/variable" } },
    "steps": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/step" } }
  },
  "$defs": {
    "shell": { "enum": ["powershell", "pwsh", "winps", "bash", "sh", "cmd"] },
    "identifier": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
    "variable": {
      "type": "object",
      "required": ["name"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/identifier" },
        "label": { "type": "string" },
        "description": { "type": "string" },
        "type": { "enum": ["string", "number", "bool", "choice", "path", "secret"], "default": "string" },
        "default": { "type": ["string", "number", "boolean"] },
        "required": { "type": "boolean", "default": false },
        "choices": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "pattern": { "type": "string", "description": "Regular expression the whole value must match." }
      },
      "if": { "properties": { "type": { "const": "choice" } }, "required": ["type"] },
      "then": { "required": ["choices"] }
    },
    "success": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "exitCodes": { "type": "array", "items": { "type": "integer" }, "minItems": 1, "default": [0] },
        "outputMatches": { "type": "string", "description": "Regular expression that must match somewhere in the combined output." },
        "outputNotMatches": { "type": "string", "description": "Regular expression that must not match anywhere in the combined output." }
      }
    },
    "capture": {
      "type": "object",
      "required": ["variable", "pattern"],
      "additionalProperties": false,
      "properties": {
        "variable": { "$ref": "#/$defs/identifier" },
        "pattern": { "type": "string", "description": "Regular expression applied to the output; the value is group 1 if the pattern has one, else the whole match." }
      }
    },
    "step": {
      "type": "object",
      "required": ["title"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Stable identifier; derived from the title when omitted." },
        "title": { "type": "string", "minLength": 1, "maxLength": 200 },
        "type": { "enum": ["info", "manual", "script"], "description": "Inferred as script when a script is present, else info." },
        "description": { "type": "string", "description": "What to do / what happens (Markdown)." },
        "why": { "type": "string", "description": "Why this step exists and what goes wrong without it (Markdown)." },
        "confirm": { "type": "string", "description": "Manual steps: the statement the person confirms, e.g. 'I have rebooted'." },
        "shell": { "$ref": "#/$defs/shell" },
        "script": { "type": "string", "minLength": 1 },
        "workingDirectory": { "type": "string" },
        "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 86400, "default": 600 },
        "env": { "type": "object", "additionalProperties": { "type": "string" } },
        "destructive": { "type": "boolean", "default": false },
        "warning": { "type": "string", "description": "Shown prominently before Run." },
        "elevated": { "type": "boolean", "default": false, "description": "The step needs administrator/root rights." },
        "when": { "type": "string", "description": "Condition; the step is offered only when it holds, else it is skipped." },
        "success": { "$ref": "#/$defs/success" },
        "captures": { "type": "array", "items": { "$ref": "#/$defs/capture" } },
        "continueOnFailure": { "type": "boolean", "default": false, "description": "A failure of this step does not block the following steps." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "script" } }, "required": ["type"] },
          "then": { "required": ["script"] }
        },
        {
          "if": { "properties": { "type": { "enum": ["info", "manual"] } }, "required": ["type"] },
          "then": { "not": { "required": ["script"] } }
        }
      ]
    }
  }
}
