<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RunbookWizard.App.App"
             RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://RunbookWizard/Styles/Tokens.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://TomLabs.AutoUpdate.Avalonia/Themes/Default.axaml" />
    <StyleInclude Source="avares://RunbookWizard/Styles/Controls.axaml" />
    <StyleInclude Source="avares://RunbookWizard/Styles/Wizard.axaml" />
  </Application.Styles>
</Application>
