<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctb="clr-namespace:ColorTextBlock.Avalonia;assembly=ColorTextBlock.Avalonia">
    <!--
        Markdown rendering in the ops-console look. Loaded by MarkdownView after Markdown.Avalonia's own style set, so these
        rules win. Everything resolves theme tokens (Tokens.axaml), so light and dark follow the app theme live.
    -->

    <Style Selector="ctb|CTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
        <Setter Property="FontFamily" Value="{StaticResource UiFont}"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20"/>
    </Style>
    <Style Selector=":is(Panel).md-secondary ctb|CTextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>

    <Style Selector="ctb|CTextBlock.Paragraph">
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
    <Style Selector="ctb|CTextBlock.Heading1">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="26"/>
        <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
    <Style Selector="ctb|CTextBlock.Heading2">
        <Setter Property="FontSize" Value="16"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="24"/>
        <Setter Property="Margin" Value="0,10,0,6"/>
    </Style>
    <Style Selector="ctb|CTextBlock.Heading3">
        <Setter Property="FontSize" Value="14"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="LineHeight" Value="22"/>
        <Setter Property="Margin" Value="0,8,0,4"/>
    </Style>
    <Style Selector="ctb|CTextBlock.Heading4, ctb|CTextBlock.Heading5, ctb|CTextBlock.Heading6">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,6,0,4"/>
    </Style>

    <Style Selector="ctb|CCode">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>
    <Style Selector="ctb|CHyperlink">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="IsUnderline" Value="True"/>
    </Style>

    <Style Selector="ctb|CTextBlock.ListMarker">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
    </Style>

    <!-- Fenced code blocks, and the editor the highlighter renders them in. -->
    <Style Selector="Border.CodeBlock">
        <Setter Property="Background" Value="{DynamicResource BgEditorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
        <Setter Property="Margin" Value="0,2,0,10"/>
    </Style>
    <Style Selector="Border.CodeBlock ctb|CTextBlock">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="LineHeight" Value="18"/>
        <Setter Property="Margin" Value="0"/>
    </Style>
    <Style Selector="Border.Blockquote">
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="2,0,0,0"/>
        <Setter Property="Padding" Value="10,0,0,0"/>
        <Setter Property="Margin" Value="0,0,0,8"/>
    </Style>
</Styles>
