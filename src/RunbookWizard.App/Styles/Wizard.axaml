<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:i="https://github.com/projektanker/icons.avalonia">
    <!-- RunbookWizard's own pieces on top of the shared ops-console styles: step status glyphs, command and output boxes, notices. -->

    <Style Selector="i|Icon.status">
        <Setter Property="Foreground" Value="{DynamicResource TextFaintBrush}"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>
    <Style Selector="i|Icon.status.running">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="i|Icon.status.done">
        <Setter Property="Foreground" Value="{DynamicResource RunningBrush}"/>
    </Style>
    <Style Selector="i|Icon.status.failed">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="i|Icon.status.skipped">
        <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
    </Style>

    <!-- The command that will run, exactly as it will be passed to the shell. -->
    <Style Selector="Border.command">
        <Setter Property="Background" Value="{DynamicResource BgEditorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineStrongBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,10"/>
    </Style>

    <!-- Live output. -->
    <Style Selector="Border.output">
        <Setter Property="Background" Value="{DynamicResource BgEditorBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource HairlineBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,8"/>
    </Style>
    <Style Selector="TextBlock.out">
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="11.5"/>
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}"/>
    </Style>
    <Style Selector="TextBlock.out.err">
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <!-- Notices: a warning the author wrote, a risk the scanner found, a problem that blocks Run. -->
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12,9"/>
    </Style>
    <Style Selector="Border.notice.error">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
    </Style>
    <Style Selector="Border.notice.ok">
        <Setter Property="BorderBrush" Value="{DynamicResource RunningBrush}"/>
        <Setter Property="Background" Value="{DynamicResource RunningSoftBrush}"/>
    </Style>

    <!-- Agent actions (ADR 0015): the request banner above the page and the "opened by an agent" notice carry the accent. -->
    <Style Selector="Border.agent-request">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="18,12"/>
    </Style>
    <Style Selector="Border.notice.agent">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="{DynamicResource ErrorSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
        <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}"/>
    </Style>

    <!-- Body text of a step: readable line length, secondary colour for the explanation. -->
    <Style Selector="SelectableTextBlock.prose">
        <Setter Property="TextWrapping" Value="Wrap"/>
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="LineHeight" Value="20"/>
        <Setter Property="MaxWidth" Value="760"/>
        <Setter Property="HorizontalAlignment" Value="Left"/>
    </Style>
    <Style Selector="Button.navrow">
        <Setter Property="HorizontalAlignment" Value="Stretch"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="14,7"/>
        <Setter Property="CornerRadius" Value="0"/>
    </Style>
    <Style Selector="Button.navrow.active">
        <Setter Property="Background" Value="{DynamicResource SelectedBrush}"/>
    </Style>

    <!-- A choice step: each option is a card-like button. -->
    <Style Selector="Button.option">
        <Setter Property="Padding" Value="14,10"/>
        <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
        <Setter Property="CornerRadius" Value="6"/>
    </Style>
    <Style Selector="Button.option.chosen">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>

    <!-- Parameter fields inside the command (ADR 0009): compact, one line high, tinted so they read as inputs in the code. -->
    <Style Selector="TextBox.param">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="5,0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>
    <Style Selector="TextBox.param:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBox.param:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource BgElevatedBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
    </Style>
    <Style Selector="TextBox.param.invalid /template/ Border#PART_BorderElement, TextBox.param.invalid:focus /template/ Border#PART_BorderElement">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>
    <Style Selector="ComboBox.param">
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="20"/>
        <Setter Property="Padding" Value="6,0"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBorderBrush}"/>
    </Style>
    <Style Selector="ComboBox.param.invalid">
        <Setter Property="BorderBrush" Value="{DynamicResource ErrorBrush}"/>
    </Style>
</Styles>
